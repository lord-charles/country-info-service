{
  "info": {
    "name": "Country Info Service",
    "description": "SOAP-to-REST country integration service. Run the folder in order (Collection Runner) for an end-to-end test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Import country (new) - 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/countries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "countries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"tanzania\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('ISO code TZ', () => pm.expect(pm.response.json().isoCode).to.eql('TZ'));",
              "pm.collectionVariables.set('countryId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Import multi-word country - 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
