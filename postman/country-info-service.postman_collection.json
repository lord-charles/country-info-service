          ],
          "path": [
            "api",
            "v1",
            "countries",
            "{{countryId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tanzania\",\n  \"capitalCity\": \"Dodoma\",\n  \"phoneCode\": \"255\",\n  \"continentCode\": \"AF\",\n  \"currencyIsoCode\": \"TZS\",\n  \"countryFlag\": \"http://www.oorsprong.org/WebSamples.CountryInfo/Flags/Tanzania.jpg\",\n  \"languages\": [\n    {\n      \"isoCode\": \"swa\",\n      \"name\": \"Swahili\"\n    },\n    {\n      \"isoCode\": \"eng\",\n      \"name\": \"English\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('Capital updated', () => pm.expect(pm.response.json().capitalCity).to.eql('Dodoma'));"
            ]
          }
        }
      ]
    },
